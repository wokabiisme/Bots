# Application Settings
APP_NAME=AI_Trading_System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_bot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=3600

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY_ENCRYPTION_KEY=your-encryption-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Broker APIs
# MetaTrader 5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET_KEY=
BYBIT_TESTNET_SECRET=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=

# Interactive Brokers
IB_ACCOUNT=
IB_USERNAME=
IB_PASSWORD=
IB_PORT=7497

# OANDA
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-trading.alpaca.markets

# News APIs
NEWS_API_KEY=
ECONOMIC_CALENDAR_API_KEY=
TWEEPY_API_KEY=
TWEEPY_API_SECRET=
TWEEPY_ACCESS_TOKEN=
TWEEPY_ACCESS_SECRET=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
TWILIO_PHONE_TO=

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_RELOAD=true
FRONTEND_URL=http://localhost:3000

# Trading Settings
PAPER_TRADING=true
LIVE_TRADING=false
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PERCENT=2.0
MAX_WEEKLY_LOSS_PERCENT=5.0
MAX_MONTHLY_LOSS_PERCENT=10.0
MAX_DRAWDOWN_PERCENT=15.0
RISK_PER_TRADE_PERCENT=1.0
PROFIT_FACTOR_THRESHOLD=2.0
WINRATE_THRESHOLD=0.45

# AI Settings
AI_MODEL_RETRAINING_FREQUENCY=weekly
AI_CONFIDENCE_THRESHOLD=0.65
AI_ENSEMBLE_MODELS=xgboost,lightgbm,catboost,rf
AI_USE_REINFORCEMENT_LEARNING=true
AI_USE_DEEP_LEARNING=true

# Backtesting
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005

# Data Collection
DATA_RETENTION_DAYS=730
CHARTS_DOWNLOAD_FREQUENCY=daily
TICK_DATA_COLLECTION=true
ECONOMIC_CALENDAR_SYNC=true
COT_REPORT_SYNC=true
WHALE_TRANSACTION_MONITORING=true
FUNDING_RATE_MONITORING=true

# System
WORKER_COUNT=4
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
HEALTH_CHECK_INTERVAL=300
AUTOMATIC_RECOVERY_ENABLED=true
EMERGENCY_SHUTDOWN_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=0.1
CIRCUIT_BREAKER_COOLDOWN=300
